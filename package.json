  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws-io/ws.io-ts-client.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": null
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "require": null
    },
    "./constants/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./core/packet": {
      "types": "./dist/core/packet/index.d.ts",
      "import": "./dist/core/packet/index.js",
      "require": null
    },
    "./core/packet/codecs": {
      "types": "./dist/core/packet/codecs/index.d.ts",
      "import": "./dist/core/packet/codecs/index.js",
      "require": null
    },
    "./core/packet/codecs/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./core/packet/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": null,
      "require": null
    },
    "./types/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": null
    },
    "./utils/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./*": "./dist/*.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "cbor-x": "^1.6.4",
    "msgpackr": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "cbor-x": {
      "optional": true
    },
    "msgpackr": {
      "optional": true
    }
  },
  "dependencies": {
    "defu": "^6.1.7",
    "p-mutex": "^1.0.0",
    "type-fest": "^5.6.0",
    "yocto-queue": "^1.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@kikiutils/eslint-config": "^9.1.2",
    "@kikiutils/tsconfigs": "^6.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cbor-x": "^1.6.4",
    "changelogen": "^0.6.2",
    "knip": "^6.11.0",
    "msgpackr": "^2.0.1",
    "publint": "^0.3.18",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.5.7",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cbor-extract",
      "esbuild",
      "msgpackr-extract"
    ]
  }
