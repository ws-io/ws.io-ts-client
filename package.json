{
  "name": "ws.io-client",
  "type": "module",
  "version": "0.1.0",
  "description": "",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws-io/ws.io-ts-client.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": null
    },
    "./*": "./dist/*.js",
    "./index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "depcheck": "depcheck",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit",
    "unused-exports": "ts-unused-exports ./tsconfig.json"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "dependencies": {
    "type-fest": "^5.1.0"
  },
  "devDependencies": {
    "@kikiutils/eslint-config": "^4.0.1",
    "@kikiutils/tsconfigs": "^5.0.5",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.6",
    "changelogen": "^0.6.2",
    "depcheck": "^1.4.7",
    "publint": "^0.3.15",
    "ts-unused-exports": "^11.0.1",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.5.5",
    "vitest": "^4.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
